# remote/kaggle.env.example
#
# Copy this file to remote/kaggle.env and fill in the values printed by the
# Kaggle bootstrap cell (the "or paste into remote/kaggle.env" block at the
# end of its output). remote/kaggle.env is gitignored -- never commit it.
#
# These values change every time you re-run the bootstrap cell (new tunnel
# port, possibly new host). Re-copy them then.
#
#   cp remote/kaggle.env.example remote/kaggle.env
#   $EDITOR remote/kaggle.env
#   remote/kremote.sh info        # check what got resolved

# Public host:port of the tunnel that forwards to sshd on the Kaggle box.
KAGGLE_HOST=bore.pub
KAGGLE_PORT=12345

# Login user on the Kaggle box (Kaggle notebooks run as root).
KAGGLE_USER=root

# Private key that matches a public key you pasted into AUTHORIZED_KEYS in
# remote/kaggle_bootstrap.py. Generate once on your laptop:
#
#   ssh-keygen -t ed25519 -f ~/.ssh/kaggle_pcap
#   cat ~/.ssh/kaggle_pcap.pub        # -> paste into AUTHORIZED_KEYS
#
# If you leave AUTHORIZED_KEYS empty, the bootstrap falls back to password
# login and prints a one-time password; connect manually with `ssh` then.
# A leading ~ is expanded.
KAGGLE_KEY=~/.ssh/kaggle_pcap

# Where the project lives on the Kaggle box (matches REMOTE_DIR in the
# bootstrap cell; persists as /kaggle/working output for the session).
KAGGLE_DIR=/kaggle/working/pcap

# Optional: extra flags for mpirun when remote/kremote.sh run/make uses it.
# With the mpich we install, root is fine and this can stay empty.
# (OpenMPI would need: MPIRUN_FLAGS=--allow-run-as-root)
# MPIRUN_FLAGS=
